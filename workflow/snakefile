from snakemake.utils import min_version

##### set minimum snakemake version #####
min_version("7.0.0")


##### setup report #####
configfile: "../config/config.yaml"


##### load rules #####


include: "rules/common.smk"
include: "rules/bcl_convert.smk"
include: "rules/ref.smk"
include: "rules/qc.smk"
include: "rules/mapping.smk"
include: "rules/fusion.smk"
include: "rules/altsplice.smk"
include: "rules/out.smk"
######

##### target rules #####

rule all:
    input:
        genome_fa,
        genome_gtf,
        samples_tsv,
        expand("{runid}/results/fastq/{sample}.{read}_001.fastq.gz", runid=runid, sample=wts_samples, read=["R1", "R2"]),
        # QC (kept in run.done)
        expand("{runid}/results/quality_control/fastq/multiqc_report.html", runid=runid),
        # duplicate-rate QC (optical + PCR)
        expand("{runid}/results/quality_control/fastq/{sample}.clump.{mode}.stats.txt", runid=runid, sample=wts_samples, mode=["opt", "pcr"]),
        # transcript-space QC
        expand("{runid}/results/quality_control/bam/{sample}.read_distribution.txt", runid=runid, sample=wts_samples),
        expand("{runid}/results/quality_control/bam/{sample}.globin.read_distribution.txt", runid=runid, sample=wts_samples),
        expand("{runid}/results/quality_control/bam/{sample}.rrna_contamination.tsv", runid=runid, sample=wts_samples),
        expand("{runid}/results/quality_control/bam/multiqc_rrna_contamination.json", runid=runid),
        expand("{runid}/results/quality_control/bam/{sample}.bam_stat.txt", runid=runid, sample=wts_samples),
        expand("{runid}/results/quality_control/bam/{sample}.infer_experiment.txt", runid=runid, sample=wts_samples),
        expand("{runid}/results/quality_control/bam/{sample}.inner_distance.txt", runid=runid, sample=wts_samples),
        expand("{runid}/results/quality_control/bam/{sample}.junction_annotation.bed", runid=runid, sample=wts_samples),
        expand("{runid}/results/quality_control/bam/{sample}.junction_saturation.pdf", runid=runid, sample=wts_samples),
        expand("{runid}/results/quality_control/bam/{sample}.read_duplication.pdf", runid=runid, sample=wts_samples),
        expand("{runid}/results/quality_control/bam/{sample}.read_gc.pdf", runid=runid, sample=wts_samples),
        # raw deliverables
        expand("{runid}/results/fusions/{sample}.fusions.tsv", runid=runid, sample=wts_samples),
        expand("{runid}/results/fusions/{sample}.fusions.discarded.tsv", runid=runid, sample=wts_samples),
        expand("{runid}/results/splicing/{sample}.SE.MATS.JC.txt", runid=runid, sample=wts_samples),
        expand("{runid}/results/splicing/{sample}.egfr_v3.out", runid=runid, sample=wts_samples),
        # final target
        expand("{bcldir}{analysis_path}/run.done", runid=runid, bcldir=bcldir, analysis_path=analysis_path),
