from snakemake.utils import min_version

##### set minimum snakemake version #####
min_version("7.0.0")


##### setup report #####
configfile: "../config/config.yaml"


##### load rules #####


include: "rules/common.smk"
include: "rules/bcl_convert.smk"
include: "rules/ref.smk"
include: "rules/qc.smk"
include: "rules/mapping.smk"
include: "rules/fusion.smk"
include: "rules/altsplice.smk"
include: "rules/out.smk"
######

##### target rules #####

rule all:
    input:
        "resources/genome.fa",
        "resources/genome.gtf",
        expand("{runid}/results/bcl2fq/{sample}.{read}_001.fastq.gz", runid=runid, sample=wts_samples, read=["R1", "R2"]),
        # QC (kept in run.done)
        expand("{runid}/results/qc/fastqc_multiqc_report.html", runid=runid),
        expand("{runid}/results/qc/bedtools/{sample}/bcov.tsv", runid=runid, sample=wts_samples),
        expand("{runid}/results/qc/n10_cov/{sample}.n10.tsv", runid=runid, sample=wts_samples),
        # duplicate-rate QC (optical + PCR)
        expand("{runid}/results/clumpify/{mode}/{sample}.clump.stats.txt", runid=runid, sample=wts_samples, mode=["opt", "pcr"]),
        # raw deliverables
        expand("{runid}/results/arriba/{sample}/fusions.tsv", runid=runid, sample=wts_samples),
        expand("{runid}/results/arriba/{sample}/fusions.discarded.tsv", runid=runid, sample=wts_samples),
        expand("{runid}/results/rmats/{sample}/SE.MATS.JC.txt", runid=runid, sample=wts_samples),
        expand("{runid}/results/rmats/{sample}.egfr_v3.out", runid=runid, sample=wts_samples),
        # final target
        expand("{bcldir}{analysis_path}/run.done", runid=runid, bcldir=bcldir, analysis_path=analysis_path),
